# Local EpiPilot configuration. Copy to .env and fill in real values.
# .env is gitignored and must never be committed.

# Required: API key for the default model profile (epipilot.config).
EPIPILOT_API_KEY=

# Optional overrides of the built-in default model profile.
# EPIPILOT_PROVIDER=Codexforme
# EPIPILOT_BASE_URL=https://blackaicoding.com/v1
# EPIPILOT_MODEL=gpt-6.1-sol
# EPIPILOT_REASONING_EFFORT=xhigh

# Research onboarding third-party API (workspace backend, server-side only).
# Base URL must be public HTTPS without /chat/completions.
# Format: json_schema or json_object — use json_object unless the provider
# truly enforces strict structured outputs (verified for your account).
# EPIPILOT_RESEARCH_API_BASE_URL=https://example-provider.com/v1
# EPIPILOT_RESEARCH_API_KEY=
# EPIPILOT_RESEARCH_API_MODEL=your-model-id
# EPIPILOT_RESEARCH_API_FORMAT=json_object
# EPIPILOT_RESEARCH_API_TIMEOUT=120
# EPIPILOT_RESEARCH_API_MAX_TOKENS=

# ChatGPT Web driving: default attaches to a local Chrome CDP endpoint when
# reachable (Chrome started with --remote-debugging-port=9222). Force a URL or
# set to off to always use the isolated browser instance.
# EPIPILOT_CHATGPT_CDP=http://127.0.0.1:9222
