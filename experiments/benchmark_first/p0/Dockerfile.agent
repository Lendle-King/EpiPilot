# Named context aidebase must resolve to the audited S0 aide image.
FROM aidebase
USER root
RUN --mount=type=cache,target=/tmp/.cache/pip pip install --timeout=120 --retries=2 \
    scikit-learn==1.5.0 scipy==1.11.4 ipython==8.37.0 matplotlib==3.8.4 \
    && pip check && pip freeze --all > /environment.txt
COPY install_codex.py /tmp/install_codex.py
RUN python /tmp/install_codex.py && codex --version
ENV PATH=/opt/codex/bin:/opt/codex/codex-path:$PATH
USER 65534:65534
WORKDIR /work
